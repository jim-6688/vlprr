# ——————————————————————————————————————————————
# 鸿蒙（HarmonyOS / OpenHarmony）
# ohos/ 由 tool/bootstrap_ohos.sh 生成，不入版本控制（含本地签名与 SDK 绝对路径）
# ——————————————————————————————————————————————
/ohos/
**/ohos/build/
**/ohos/.hvigor/
**/ohos/oh_modules/
**/ohos/local.properties
**/ohos/.cxx/
*.hap
*.har
*.hsp

# ——————————————————————————————————————————————
# 密钥与敏感配置（重要）
# API Key 一律通过 --dart-define 注入，绝不落库
# ——————————————————————————————————————————————
*.keystore
*.jks
key.properties
**/local.properties
.env
.env.*
!env.example

